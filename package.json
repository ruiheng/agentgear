{
  "name": "@ruiheng/agentgear",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Portable utilities and workflow orchestration for AI-agent harnesses.",
  "keywords": [
    "ai-agent",
    "agent-harness",
    "orchestration",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruiheng/agentgear.git"
  },
  "homepage": "https://github.com/ruiheng/agentgear#readme",
  "bugs": {
    "url": "https://github.com/ruiheng/agentgear/issues"
  },
  "type": "module",
  "bin": {
    "agentgear": "bin/agentgear.mjs"
  },
  "files": [
    "bin/agentgear.mjs",
    "bin/agentgear-link.mjs",
    "catalog",
    "cli/agentgear.mjs",
    "cli/link.mjs",
    "cli/lib",
    "config",
    "providers",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "link": "node ./bin/agentgear-link.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test --test-concurrency=1 tests/cli.test.mjs tests/workflow-permissions.test.mjs skills/agent-deck-workflow/scripts/archive-and-remove-planner-group-sessions.test.mjs skills/agent-deck-workflow/scripts/resolve-tool-command.test.js",
    "check": "npm run validate && npm run build && npm test",
    "prepublishOnly": "npm run check"
  }
}
