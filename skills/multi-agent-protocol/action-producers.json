{
  "schemaVersion": 1,
  "module": "action-producers.mjs",
  "actions": {
    "REVIEW_TASK_CONTEXT": {
      "token": "review_task_context",
      "script": "send-delegate-with-active-task-lock.mjs",
      "export": "REVIEW_TASK_CONTEXT",
      "factory": "reviewTaskContextMessage",
      "sender": "sendReviewTaskContextMessage"
    },
    "EXECUTE_DELEGATE_TASK": {
      "token": "execute_delegate_task",
      "script": "send-delegate-with-active-task-lock.mjs",
      "export": "EXECUTE_DELEGATE_TASK",
      "factory": "executeDelegateTaskMessage",
      "sender": "sendExecuteDelegateTaskMessage"
    }
  }
}
