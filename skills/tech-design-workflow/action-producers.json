{
  "schemaVersion": 1,
  "module": "action-producers.mjs",
  "actions": {
    "DESIGN_SPEC_REVIEW_CONTEXT": {
      "token": "design_spec_review_context",
      "sticky": true,
      "script": "send-design-draft-with-review-context.mjs",
      "export": "DESIGN_SPEC_REVIEW_CONTEXT",
      "factory": "designSpecReviewContextMessage",
      "sender": "sendDesignSpecReviewContextMessage"
    },
    "DESIGN_SPEC_DRAFT_REQUESTED": {
      "token": "design_spec_draft_requested",
      "sticky": true,
      "script": "send-design-draft-with-review-context.mjs",
      "export": "DESIGN_SPEC_DRAFT_REQUESTED",
      "factory": "designSpecDraftRequestedMessage",
      "sender": "sendDesignSpecDraftRequestedMessage"
    },
    "DESIGN_PRUNE_CONTEXT": {
      "token": "design_prune_context",
      "sticky": true,
      "script": "send-design-draft-with-review-context.mjs",
      "export": "DESIGN_PRUNE_CONTEXT",
      "factory": "designPruneContextMessage",
      "sender": "sendDesignPruneContextMessage"
    },
    "DESIGN_SPEC_REVIEW_REQUESTED": {
      "token": "design_spec_review_requested",
      "sticky": false,
      "script": "dispatch-design-review.mjs",
      "export": "DESIGN_SPEC_REVIEW_REQUESTED",
      "factory": "designSpecReviewRequestedMessage",
      "sender": "sendDesignSpecReviewRequestedMessage"
    },
    "DESIGN_PRUNE_REQUESTED": {
      "token": "design_prune_requested",
      "sticky": false,
      "script": "dispatch-design-review.mjs",
      "export": "DESIGN_PRUNE_REQUESTED",
      "factory": "designPruneRequestedMessage",
      "sender": "sendDesignPruneRequestedMessage"
    }
  }
}
